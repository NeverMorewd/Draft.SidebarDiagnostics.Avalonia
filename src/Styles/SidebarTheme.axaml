<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SidebarDiagnostics.App.Controls">
    <Styles.Resources>
        <SolidColorBrush x:Key="BackgroundWindowBrush" Color="#0B0F17" />
        <SolidColorBrush x:Key="BackgroundInputBrush" Color="#0B1220" />
        <SolidColorBrush x:Key="BackgroundInputDisabledBrush" Color="#0B111B" />
        <SolidColorBrush x:Key="BackgroundCardBrush" Color="#111827" />
        <SolidColorBrush x:Key="BackgroundCardAlternateBrush" Color="#101722" />
        <SolidColorBrush x:Key="BackgroundPanelBrush" Color="#0E1623" />
        <SolidColorBrush x:Key="BackgroundControlBrush" Color="#142033" />
        <SolidColorBrush x:Key="BackgroundControlHoverBrush" Color="#1D2D43" />
        <SolidColorBrush x:Key="BackgroundControlDisabledBrush" Color="#0F1724" />
        <SolidColorBrush x:Key="BackgroundControlSecondaryBrush" Color="#111C2A" />
        <SolidColorBrush x:Key="BackgroundControlSecondaryHoverBrush" Color="#1A2A3D" />
        <SolidColorBrush x:Key="BackgroundAccentSubtleBrush" Color="#12314A" />
        <SolidColorBrush x:Key="BackgroundAccentHoverBrush" Color="#17314A" />
        <SolidColorBrush x:Key="BackgroundDangerSubtleBrush" Color="#2A1720" />
        <SolidColorBrush x:Key="BackgroundDangerHoverBrush" Color="#7F1D2D" />
        <SolidColorBrush x:Key="BackgroundSuccessBrush" Color="#0D332D" />
        <SolidColorBrush x:Key="BackgroundMenuBrush" Color="#0D1521" />
        <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

        <SolidColorBrush x:Key="BorderDefaultBrush" Color="#2A3B52" />
        <SolidColorBrush x:Key="BorderHoverBrush" Color="#3B5874" />
        <SolidColorBrush x:Key="BorderFocusBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="BorderDisabledBrush" Color="#1C293A" />
        <SolidColorBrush x:Key="BorderCardBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="BorderPanelBrush" Color="#223149" />
        <SolidColorBrush x:Key="BorderChromeBrush" Color="#1B283A" />
        <SolidColorBrush x:Key="BorderAccentBrush" Color="#4EA7D8" />
        <SolidColorBrush x:Key="BorderDangerBrush" Color="#BE3651" />

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="TextBodyBrush" Color="#CBD5E1" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextSubtleBrush" Color="#71839B" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#526278" />
        <SolidColorBrush x:Key="TextAccentBrush" Color="#7DD3FC" />
        <SolidColorBrush x:Key="TextAccentStrongBrush" Color="#BAE6FD" />
        <SolidColorBrush x:Key="TextDangerBrush" Color="#FDA4AF" />
        <SolidColorBrush x:Key="TextSuccessBrush" Color="#6EE7B7" />

        <SolidColorBrush x:Key="AccentCpuBrush" Color="#7DD3FC" />
        <SolidColorBrush x:Key="AccentMemoryBrush" Color="#C4B5FD" />
        <SolidColorBrush x:Key="AccentStorageBrush" Color="#6EE7B7" />
        <SolidColorBrush x:Key="AccentNetworkBrush" Color="#FDE68A" />
        <SolidColorBrush x:Key="AccentGpuBrush" Color="#FB923C" />
        <SolidColorBrush x:Key="AccentHardwareBrush" Color="#F472B6" />
        <SolidColorBrush x:Key="AccentWarningBrush" Color="#FB7185" />
        <SolidColorBrush x:Key="AccentExternalBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentSuccessBrush" Color="#34D399" />

        <SolidColorBrush x:Key="ChartGridBrush" Color="#223047" />
        <SolidColorBrush x:Key="ChartAxisBrush" Color="#354760" />
        <SolidColorBrush x:Key="ChartPointOutlineBrush" Color="#FFFFFF" />

        <x:Double x:Key="FontSizeMicro">9</x:Double>
        <x:Double x:Key="FontSizeCaption">10</x:Double>
        <x:Double x:Key="FontSizeBody">11</x:Double>
        <x:Double x:Key="FontSizeDescription">12</x:Double>
        <x:Double x:Key="FontSizeSection">13</x:Double>
        <x:Double x:Key="FontSizeSubheading">14</x:Double>
        <x:Double x:Key="FontSizeHeading">16</x:Double>
        <x:Double x:Key="FontSizeIcon">17</x:Double>
        <x:Double x:Key="FontSizeTitle">22</x:Double>
        <x:Double x:Key="FontSizePageTitle">24</x:Double>
        <x:Double x:Key="FontSizeCloseIcon">21</x:Double>
        <x:Double x:Key="FontSizeDisplay">30</x:Double>

        <CornerRadius x:Key="RadiusAccentBar">2</CornerRadius>
        <CornerRadius x:Key="RadiusControl">7</CornerRadius>
        <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
        <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
        <CornerRadius x:Key="RadiusAction">11</CornerRadius>
        <CornerRadius x:Key="RadiusCard">14</CornerRadius>
        <CornerRadius x:Key="RadiusPanel">16</CornerRadius>

        <Thickness x:Key="ThicknessBorder">1</Thickness>
        <Thickness x:Key="ThicknessChromeBottom">0,0,0,1</Thickness>
        <Thickness x:Key="ThicknessChromeTop">0,1,0,0</Thickness>
        <Thickness x:Key="PaddingControl">12,7</Thickness>
        <Thickness x:Key="PaddingCard">18</Thickness>
        <Thickness x:Key="PaddingCompactCard">14</Thickness>
        <Thickness x:Key="PaddingWindow">28</Thickness>
        <Thickness x:Key="PaddingSidebarChrome">16,11</Thickness>
        <Thickness x:Key="PaddingSidebarStatus">16,10</Thickness>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BackgroundWindowBrush}" />
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown">
        <Setter Property="Background" Value="{DynamicResource BackgroundInputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ThicknessBorder}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBox:pointerover, ComboBox:pointerover, NumericUpDown:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
    </Style>
    <Style Selector="TextBox:focus, TextBox:focus-within, ComboBox:focus, ComboBox:focus-within, NumericUpDown:focus, NumericUpDown:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
    </Style>
    <Style Selector="TextBox:disabled, ComboBox:disabled, NumericUpDown:disabled">
        <Setter Property="Background" Value="{DynamicResource BackgroundInputDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDisabledBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    </Style>
    <Style Selector="NumericUpDown RepeatButton, ComboBox ToggleButton">
        <Setter Property="Background" Value="{DynamicResource BackgroundControlSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="NumericUpDown RepeatButton:pointerover, ComboBox ToggleButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource BackgroundControlSecondaryHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextAccentStrongBrush}" />
    </Style>
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource BackgroundControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ThicknessBorder}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource BackgroundControlHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button:focus"><Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" /></Style>
    <Style Selector="Button:disabled">
        <Setter Property="Background" Value="{DynamicResource BackgroundControlDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDisabledBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    </Style>
    <Style Selector="CheckBox:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" /></Style>
    <Style Selector="CheckBox:checked"><Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" /></Style>
    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource BackgroundControlSecondaryHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource BackgroundAccentSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextAccentStrongBrush}" />
    </Style>
    <Style Selector="ScrollBar"><Setter Property="Background" Value="{DynamicResource TransparentBrush}" /></Style>
    <Style Selector="ScrollBar /template/ Thumb"><Setter Property="Background" Value="{DynamicResource BorderHoverBrush}" /></Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover"><Setter Property="Background" Value="{DynamicResource TextSubtleBrush}" /></Style>
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="Background" Value="{DynamicResource BackgroundMenuBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ThicknessBorder}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
        <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="MenuItem:pointerover, MenuItem:selected">
        <Setter Property="Background" Value="{DynamicResource BackgroundAccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="MenuItem:disabled"><Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" /></Style>
    <Style Selector="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="9,5" />
        <Setter Property="Background" Value="{DynamicResource BorderDefaultBrush}" />
    </Style>

    <Style Selector="Grid.metric-row Button.metric-chart">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Background" Value="{DynamicResource BackgroundControlSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ThicknessBorder}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>
    <Style Selector="Grid.metric-row:pointerover Button.metric-chart">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.metric-chart:pointerover, Button.metric-chart:focus">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BackgroundAccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextAccentStrongBrush}" />
    </Style>
    <Style Selector="Button.chrome">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource BackgroundControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ThicknessBorder}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
    </Style>
    <Style Selector="Button.chrome:pointerover">
        <Setter Property="Background" Value="{DynamicResource BackgroundControlHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.close:pointerover">
        <Setter Property="Background" Value="{DynamicResource BackgroundDangerHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.pinned">
        <Setter Property="Background" Value="{DynamicResource BackgroundAccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentExternalBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
        <Setter Property="Background" Value="{DynamicResource BackgroundCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderCardBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ThicknessBorder}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
    </Style>
    <Style Selector="Border.compact-card">
        <Setter Property="Background" Value="{DynamicResource BackgroundInputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderCardBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ThicknessBorder}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}" />
        <Setter Property="LetterSpacing" Value="1.8" />
    </Style>
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.section-title">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.description">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="controls|MetricChart">
        <Setter Property="LabelBrush" Value="{DynamicResource TextSubtleBrush}" />
        <Setter Property="GridBrush" Value="{DynamicResource ChartGridBrush}" />
        <Setter Property="AxisBrush" Value="{DynamicResource ChartAxisBrush}" />
        <Setter Property="PointOutlineBrush" Value="{DynamicResource ChartPointOutlineBrush}" />
    </Style>
    <Style Selector="controls|Sparkline">
        <Setter Property="Stroke" Value="{DynamicResource AccentCpuBrush}" />
    </Style>
</Styles>
