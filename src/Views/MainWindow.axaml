<Window
    x:Class="SidebarDiagnostics.App.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SidebarDiagnostics.App.Models"
    xmlns:vm="using:SidebarDiagnostics.App.ViewModels"
    Title="Sidebar Diagnostics"
    Width="360"
    Height="920"
    MinWidth="320"
    MinHeight="620"
    d:DesignHeight="920"
    d:DesignWidth="360"
    x:DataType="vm:MainViewModel"
    Background="#0B0F17"
    Icon="/Assets/sidebar.ico"
    ShowInTaskbar="False"
    Topmost="True"
    WindowDecorations="None"
    mc:Ignorable="d">
    <Window.Styles>
        <Style Selector="Border.window-chrome">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Window:pointerover Border.window-chrome">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="ScrollViewer.main-scroll">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        </Style>
        <Style Selector="Window:pointerover ScrollViewer.main-scroll">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style Selector="Grid.metric-row Button.metric-chart">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Background" Value="#0D1825" />
            <Setter Property="BorderBrush" Value="#29415A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Grid.metric-row:pointerover Button.metric-chart">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.metric-chart:pointerover, Button.metric-chart:focus">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="#17314A" />
            <Setter Property="BorderBrush" Value="#4EA7D8" />
            <Setter Property="Foreground" Value="#BAE6FD" />
        </Style>
    </Window.Styles>
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border
            Grid.Row="0"
            Classes="window-chrome"
            Padding="16,11"
            BorderBrush="#1B2535"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
                <StackPanel PointerPressed="BeginWindowDrag" Spacing="1">
                    <TextBlock
                        FontSize="9"
                        FontWeight="SemiBold"
                        Foreground="#7DD3FC"
                        LetterSpacing="1.4"
                        Text="SIDEBAR DIAGNOSTICS" />
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#F8FAFC"
                        IsVisible="{Binding IsMachineNameVisible}"
                        Text="{Binding MachineName}" />
                    <TextBlock
                        FontSize="10"
                        Foreground="#94A3B8"
                        Text="{Binding PlatformName}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="10"
                        Foreground="#CBD5E1"
                        IsVisible="{Binding IsClockVisible}"
                        Text="{Binding ClockText}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    Padding="0"
                    Background="#122033"
                    Click="OpenSettings"
                    CornerRadius="11"
                    Foreground="#7DD3FC"
                    ToolTip.Tip="Settings">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="17"
                        Text="⚙" />
                </Button>
                <Button
                    Grid.Column="2"
                    Width="36"
                    Height="36"
                    Padding="0"
                    Background="#2A1720"
                    Click="HideToTray"
                    CornerRadius="11"
                    Foreground="#FDA4AF"
                    ToolTip.Tip="Hide to tray">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="21"
                        Text="×" />
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Classes="main-scroll">
            <StackPanel Margin="16,10">
                <ItemsControl ItemsSource="{Binding DiagnosticSections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DiagnosticSection">
                            <Border
                                Margin="0,0,0,10"
                                Padding="14"
                                Background="#101722"
                                BorderBrush="#1F2937"
                                BorderThickness="1"
                                CornerRadius="14">
                                <StackPanel Spacing="9">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                        <Border
                                            Width="4"
                                            Background="{Binding AccentColor}"
                                            CornerRadius="2" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#F8FAFC"
                                                Text="{Binding Title}" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="#64748B"
                                                Text="{Binding Subtitle}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Metrics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiagnosticMetric">
                                                <Grid Margin="0,2" Background="Transparent" Classes="metric-row" ColumnDefinitions="110,*,Auto">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="#94A3B8"
                                                        Text="{Binding Label}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        FontSize="11"
                                                        FontWeight="Medium"
                                                        Foreground="#E2E8F0"
                                                        Text="{Binding Value}"
                                                        TextWrapping="Wrap" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Classes="metric-chart"
                                                        Width="27"
                                                        Height="25"
                                                        Margin="6,0,0,0"
                                                        Padding="0"
                                                        Click="OpenMetricChart"
                                                        Foreground="#7DD3FC"
                                                        IsVisible="{Binding CanGraph}"
                                                        ToolTip.Tip="Open live chart">
                                                        <Path
                                                            Width="14"
                                                            Height="12"
                                                            Data="M 1,10 L 5,6 L 8,8 L 13,2"
                                                            Stretch="Fill"
                                                            Stroke="{Binding $parent[Button].Foreground}"
                                                            StrokeThickness="1.5" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Classes="window-chrome"
            Padding="16,10"
            BorderBrush="#1B2535"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse
                    Width="7"
                    Height="7"
                    VerticalAlignment="Center"
                    Fill="#34D399" />
                <TextBlock
                    Grid.Column="1"
                    Margin="9,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="#94A3B8"
                    Text="{Binding StatusText}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="#64748B"
                    Text="{Binding LastUpdated}" />
            </Grid>
        </Border>
    </Grid>
</Window>
