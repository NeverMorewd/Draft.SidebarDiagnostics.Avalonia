<Window
    x:Class="SidebarDiagnostics.App.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SidebarDiagnostics.App.Models"
    xmlns:vm="using:SidebarDiagnostics.App.ViewModels"
    Title="Sidebar Diagnostics"
    Width="360"
    Height="920"
    MinWidth="320"
    MinHeight="620"
    d:DesignHeight="920"
    d:DesignWidth="360"
    x:DataType="vm:MainViewModel"
    Background="{DynamicResource BackgroundWindowBrush}"
    Icon="/Assets/sidebar.ico"
    ShowInTaskbar="False"
    Topmost="True"
    WindowDecorations="None"
    mc:Ignorable="d">
    <Window.Styles>
        <Style Selector="Border.window-chrome">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Window:pointerover Border.window-chrome">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="ScrollViewer.main-scroll">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        </Style>
        <Style Selector="Window:pointerover ScrollViewer.main-scroll">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </Window.Styles>
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border
            Grid.Row="0"
            Classes="window-chrome"
            Padding="{DynamicResource PaddingSidebarChrome}"
            BorderBrush="{DynamicResource BorderChromeBrush}"
            BorderThickness="{DynamicResource ThicknessChromeBottom}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="7">
                <StackPanel PointerPressed="BeginWindowDrag" Spacing="1">
                    <TextBlock
                        FontSize="{DynamicResource FontSizeMicro}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextAccentBrush}"
                        LetterSpacing="1.4"
                        Text="SIDEBAR DIAGNOSTICS" />
                    <TextBlock
                        FontSize="{DynamicResource FontSizeHeading}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        IsVisible="{Binding IsMachineNameVisible}"
                        Text="{Binding MachineName}" />
                    <TextBlock
                        FontSize="{DynamicResource FontSizeCaption}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{Binding PlatformName}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="{DynamicResource FontSizeCaption}"
                        Foreground="{DynamicResource TextBodyBrush}"
                        IsVisible="{Binding IsClockVisible}"
                        Text="{Binding ClockText}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    Padding="0"
                    Background="{DynamicResource BackgroundAccentSubtleBrush}"
                    Click="OpenAbout"
                    CornerRadius="{DynamicResource RadiusAction}"
                    Foreground="{DynamicResource TextAccentBrush}"
                    ToolTip.Tip="About">
                    <Border
                        Width="17"
                        Height="17"
                        BorderBrush="{Binding $parent[Button].Foreground}"
                        BorderThickness="1.4"
                        CornerRadius="{DynamicResource RadiusSmall}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSizeBody}"
                            FontWeight="Bold"
                            Text="i" />
                    </Border>
                </Button>
                <Button
                    Grid.Column="2"
                    Width="36"
                    Height="36"
                    Padding="0"
                    Background="{DynamicResource BackgroundAccentSubtleBrush}"
                    Click="OpenSettings"
                    CornerRadius="{DynamicResource RadiusAction}"
                    Foreground="{DynamicResource TextAccentBrush}"
                    ToolTip.Tip="Settings">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource FontSizeIcon}"
                        Text="⚙" />
                </Button>
                <Button
                    Grid.Column="3"
                    Width="36"
                    Height="36"
                    Padding="0"
                    Background="{DynamicResource BackgroundDangerSubtleBrush}"
                    Click="HideToTray"
                    CornerRadius="{DynamicResource RadiusAction}"
                    Foreground="{DynamicResource TextDangerBrush}"
                    ToolTip.Tip="Hide to tray">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource FontSizeCloseIcon}"
                        Text="×" />
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Classes="main-scroll">
            <StackPanel Margin="16,10">
                <ItemsControl ItemsSource="{Binding DiagnosticSections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DiagnosticSection">
                            <Border
                                Margin="0,0,0,10"
                                Padding="{DynamicResource PaddingCompactCard}"
                                Background="{DynamicResource BackgroundCardAlternateBrush}"
                                BorderBrush="{DynamicResource BorderCardBrush}"
                                BorderThickness="{DynamicResource ThicknessBorder}"
                                CornerRadius="{DynamicResource RadiusCard}">
                                <StackPanel Spacing="9">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                        <Border
                                            Width="4"
                                            Background="{Binding AccentResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                                            CornerRadius="{DynamicResource RadiusAccentBar}" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock
                                                FontSize="{DynamicResource FontSizeSection}"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="{Binding Title}" />
                                            <TextBlock
                                                FontSize="{DynamicResource FontSizeCaption}"
                                                Foreground="{DynamicResource TextDimBrush}"
                                                Text="{Binding Subtitle}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Metrics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiagnosticMetric">
                                                <Grid Margin="0,2" Background="{DynamicResource TransparentBrush}" Classes="metric-row" ColumnDefinitions="110,*,Auto">
                                                    <TextBlock
                                                        FontSize="{DynamicResource FontSizeBody}"
                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                        Text="{Binding Label}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        FontSize="{DynamicResource FontSizeBody}"
                                                        FontWeight="Medium"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        Text="{Binding Value}"
                                                        TextWrapping="Wrap" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Classes="metric-chart"
                                                        Width="27"
                                                        Height="25"
                                                        Margin="6,0,0,0"
                                                        Padding="0"
                                                        Click="OpenMetricChart"
                                                        Foreground="{DynamicResource TextAccentBrush}"
                                                        IsVisible="{Binding CanGraph}"
                                                        ToolTip.Tip="Open live chart">
                                                        <Path
                                                            Width="14"
                                                            Height="12"
                                                            Data="M 1,10 L 5,6 L 8,8 L 13,2"
                                                            Stretch="Fill"
                                                            Stroke="{Binding $parent[Button].Foreground}"
                                                            StrokeThickness="1.5" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Classes="window-chrome"
            Padding="{DynamicResource PaddingSidebarStatus}"
            BorderBrush="{DynamicResource BorderChromeBrush}"
            BorderThickness="{DynamicResource ThicknessChromeTop}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse
                    Width="7"
                    Height="7"
                    VerticalAlignment="Center"
                    Fill="{DynamicResource AccentSuccessBrush}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="9,0"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeBody}"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="{Binding StatusText}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeBody}"
                    Foreground="{DynamicResource TextDimBrush}"
                    Text="{Binding LastUpdated}" />
            </Grid>
        </Border>
    </Grid>
</Window>
