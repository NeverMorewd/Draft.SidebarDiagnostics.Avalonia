<Window
    x:Class="SidebarDiagnostics.App.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SidebarDiagnostics.App.Models"
    xmlns:vm="using:SidebarDiagnostics.App.ViewModels"
    Title="Sidebar Diagnostics"
    Width="360"
    Height="920"
    MinWidth="320"
    MinHeight="620"
    d:DesignHeight="920"
    d:DesignWidth="360"
    x:DataType="vm:MainViewModel"
    Background="{StaticResource BackgroundWindowBrush}"
    Icon="/Assets/sidebar.ico"
    ShowInTaskbar="False"
    Topmost="True"
    WindowDecorations="None"
    mc:Ignorable="d">
    <Window.Styles>
        <Style Selector="Border.window-chrome">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Window:pointerover Border.window-chrome">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="ScrollViewer.main-scroll">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        </Style>
        <Style Selector="Window:pointerover ScrollViewer.main-scroll">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </Window.Styles>
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border
            Grid.Row="0"
            Classes="window-chrome"
            Padding="{StaticResource PaddingSidebarChrome}"
            BorderBrush="{StaticResource BorderChromeBrush}"
            BorderThickness="{StaticResource ThicknessChromeBottom}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="7">
                <StackPanel PointerPressed="BeginWindowDrag" Spacing="1">
                    <TextBlock
                        FontSize="{StaticResource FontSizeMicro}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextAccentBrush}"
                        LetterSpacing="1.4"
                        Text="SIDEBAR DIAGNOSTICS" />
                    <TextBlock
                        FontSize="{StaticResource FontSizeHeading}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        IsVisible="{Binding IsMachineNameVisible}"
                        Text="{Binding MachineName}" />
                    <TextBlock
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="{Binding PlatformName}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        IsVisible="{Binding IsClockVisible}"
                        Text="{Binding ClockText}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    Padding="0"
                    Background="{StaticResource BackgroundAccentSubtleBrush}"
                    Click="OpenAbout"
                    CornerRadius="{StaticResource RadiusAction}"
                    Foreground="{StaticResource TextAccentBrush}"
                    ToolTip.Tip="About">
                    <Border
                        Width="17"
                        Height="17"
                        BorderBrush="{Binding $parent[Button].Foreground}"
                        BorderThickness="1.4"
                        CornerRadius="{StaticResource RadiusSmall}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            FontWeight="Bold"
                            Text="i" />
                    </Border>
                </Button>
                <Button
                    Grid.Column="2"
                    Width="36"
                    Height="36"
                    Padding="0"
                    Background="{StaticResource BackgroundAccentSubtleBrush}"
                    Click="OpenSettings"
                    CornerRadius="{StaticResource RadiusAction}"
                    Foreground="{StaticResource TextAccentBrush}"
                    ToolTip.Tip="Settings">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeIcon}"
                        Text="⚙" />
                </Button>
                <Button
                    Grid.Column="3"
                    Width="36"
                    Height="36"
                    Padding="0"
                    Background="{StaticResource BackgroundDangerSubtleBrush}"
                    Click="HideToTray"
                    CornerRadius="{StaticResource RadiusAction}"
                    Foreground="{StaticResource TextDangerBrush}"
                    ToolTip.Tip="Hide to tray">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCloseIcon}"
                        Text="×" />
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Classes="main-scroll">
            <StackPanel Margin="16,10">
                <ItemsControl ItemsSource="{Binding DiagnosticSections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DiagnosticSection">
                            <Border
                                Margin="0,0,0,10"
                                Padding="{StaticResource PaddingCompactCard}"
                                Background="{StaticResource BackgroundCardAlternateBrush}"
                                BorderBrush="{StaticResource BorderCardBrush}"
                                BorderThickness="{StaticResource ThicknessBorder}"
                                CornerRadius="{StaticResource RadiusCard}">
                                <StackPanel Spacing="9">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                        <Border
                                            Width="4"
                                            Background="{Binding AccentResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                                            CornerRadius="{StaticResource RadiusAccentBar}" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock
                                                FontSize="{StaticResource FontSizeSection}"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                Text="{Binding Title}" />
                                            <TextBlock
                                                FontSize="{StaticResource FontSizeCaption}"
                                                Foreground="{StaticResource TextDimBrush}"
                                                Text="{Binding Subtitle}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Metrics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiagnosticMetric">
                                                <Grid Margin="0,2" Background="{StaticResource TransparentBrush}" Classes="metric-row" ColumnDefinitions="110,*,Auto">
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSizeBody}"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        Text="{Binding Label}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        FontSize="{StaticResource FontSizeBody}"
                                                        FontWeight="Medium"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        Text="{Binding Value}"
                                                        TextWrapping="Wrap" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Classes="metric-chart"
                                                        Width="27"
                                                        Height="25"
                                                        Margin="6,0,0,0"
                                                        Padding="0"
                                                        Click="OpenMetricChart"
                                                        Foreground="{StaticResource TextAccentBrush}"
                                                        IsVisible="{Binding CanGraph}"
                                                        ToolTip.Tip="Open live chart">
                                                        <Path
                                                            Width="14"
                                                            Height="12"
                                                            Data="M 1,10 L 5,6 L 8,8 L 13,2"
                                                            Stretch="Fill"
                                                            Stroke="{Binding $parent[Button].Foreground}"
                                                            StrokeThickness="1.5" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Classes="window-chrome"
            Padding="{StaticResource PaddingSidebarStatus}"
            BorderBrush="{StaticResource BorderChromeBrush}"
            BorderThickness="{StaticResource ThicknessChromeTop}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse
                    Width="7"
                    Height="7"
                    VerticalAlignment="Center"
                    Fill="{StaticResource AccentSuccessBrush}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="9,0"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeBody}"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="{Binding StatusText}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeBody}"
                    Foreground="{StaticResource TextDimBrush}"
                    Text="{Binding LastUpdated}" />
            </Grid>
        </Border>
    </Grid>
</Window>
