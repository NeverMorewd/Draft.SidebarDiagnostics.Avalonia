<Window
    x:Class="SidebarDiagnostics.App.Views.SettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SidebarDiagnostics.App.ViewModels"
    xmlns:localization="using:SidebarDiagnostics.App.Localization"
    Title="{DynamicResource TextSidebarDiagnosticsSettings}"
    Width="440"
    Height="780"
    MinWidth="400"
    MinHeight="600"
    x:DataType="vm:SettingsViewModel"
    Background="{DynamicResource BackgroundWindowBrush}"
    ExtendClientAreaToDecorationsHint="True"
    WindowDecorations="BorderOnly"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <localization:LocalizedEnumConverter x:Key="LocalizedEnumConverter" />
    </Window.Resources>
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel
            Grid.Row="0"
            MaxWidth="920"
            Margin="28,24,28,16"
            HorizontalAlignment="Stretch"
            Spacing="4">
            <TextBlock
                FontSize="{DynamicResource FontSizeBody}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextAccentBrush}"
                LetterSpacing="1.8"
                Text="{DynamicResource TextSettingsHeading}" />
            <TextBlock
                FontSize="{DynamicResource FontSizePageTitle}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="{DynamicResource TextMonitoringPreferences}" />
            <TextBlock
                FontSize="{DynamicResource FontSizeDescription}"
                Foreground="{DynamicResource TextMutedBrush}"
                Text="{DynamicResource TextChangesApplyImmediatelyAndPersistAfterSaving}"
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                MaxWidth="920"
                Margin="28,0,28,24"
                HorizontalAlignment="Stretch"
                Spacing="22">
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource TextLanguage}" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="localization:LanguageOption">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource TextLanguageChangesApplyAfterSaving}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{DynamicResource TextGlobalShortcuts}" />
                        <TextBlock
                            FontSize="{DynamicResource FontSizeBody}"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="{DynamicResource TextUseModifiersPlusALetterNumberOrFunctionKeyClearAFieldToDisableIt}"
                            TextWrapping="Wrap" />
                        <Grid
                            ColumnDefinitions="120,*"
                            ColumnSpacing="10"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="8">
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource TextShowAndFocus}" />
                            <TextBox Grid.Column="1" Text="{Binding ShowShortcut}" />
                            <TextBlock
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                Text="{DynamicResource TextHide}" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding HideShortcut}" />
                            <TextBlock
                                Grid.Row="2"
                                VerticalAlignment="Center"
                                Text="{DynamicResource TextToggle}" />
                            <TextBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="{Binding ToggleShortcut}" />
                        </Grid>
                        <TextBlock
                            FontSize="{DynamicResource FontSizeBody}"
                            Foreground="{DynamicResource TextAccentBrush}"
                            Text="{Binding ShortcutStatus}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{DynamicResource TextRefreshInterval}" />
                        <NumericUpDown
                            FormatString="0 ms"
                            Increment="250"
                            Maximum="10000"
                            Minimum="250"
                            Value="{Binding RefreshIntervalMilliseconds}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{DynamicResource TextAppearance}" />
                        <Grid
                            ColumnDefinitions="*,180"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextBodyBrush}"
                                Text="{DynamicResource TextTheme}" />
                            <ComboBox
                                Grid.Column="1"
                                ItemsSource="{Binding Themes}"
                                SelectedItem="{Binding SelectedTheme}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ApplicationThemeOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextBodyBrush}"
                                IsVisible="{Binding IsPipboyTheme}"
                                Text="{DynamicResource TextPrimaryColor}" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="1"
                                IsVisible="{Binding IsPipboyTheme}"
                                ItemsSource="{Binding PipboyColors}"
                                SelectedItem="{Binding SelectedPipboyColor}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PipboyColorOption">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border
                                                Width="12"
                                                Height="12"
                                                VerticalAlignment="Center"
                                                Background="{Binding PreviewBrush}"
                                                CornerRadius="6" />
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock
                                Grid.Row="2"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextBodyBrush}"
                                Text="{DynamicResource TextSidebarWidth}" />
                            <NumericUpDown
                                Grid.Row="2"
                                Grid.Column="1"
                                FormatString="0 px"
                                Increment="10"
                                Maximum="640"
                                Minimum="320"
                                Value="{Binding SidebarWidth}" />
                            <TextBlock
                                Grid.Row="3"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextBodyBrush}"
                                Text="{DynamicResource TextWindowOpacity}" />
                            <Grid
                                Grid.Row="3"
                                Grid.Column="1"
                                ColumnDefinitions="*,42"
                                ColumnSpacing="10">
                                <Slider
                                    Maximum="1"
                                    Minimum="0.4"
                                    TickFrequency="0.05"
                                    Value="{Binding WindowOpacity}" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="{Binding WindowOpacityPercent, StringFormat='{}{0}%'}" />
                            </Grid>
                        </Grid>
                        <CheckBox Content="{DynamicResource TextShowMachineName}" IsChecked="{Binding ShowMachineName}" />
                        <CheckBox Content="{DynamicResource TextShowClockAndDate}" IsChecked="{Binding ShowClock}" />
                        <CheckBox Content="{DynamicResource TextUse24HourClock}" IsChecked="{Binding Use24HourClock}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextBodyBrush}"
                                Text="{DynamicResource TextDateFormat}" />
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="140"
                                ItemsSource="{Binding ClockDateFormats}"
                                SelectedItem="{Binding SelectedClockDateFormat}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ClockDateFormatOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <CheckBox Content="{DynamicResource TextShowExternalIPAddress}" IsChecked="{Binding ShowExternalIpAddress}" />
                        <TextBlock
                            FontSize="{DynamicResource FontSizeCaption}"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="{DynamicResource TextUsesApiIpifyOrgAndCachesTheResultFor30Minutes}"
                            TextWrapping="Wrap" />
                        <CheckBox Content="{DynamicResource TextShowTemperaturesInFahrenheit}" IsChecked="{Binding UseFahrenheit}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{DynamicResource TextDisplayPlacement}" />
                        <TextBlock
                            FontSize="{DynamicResource FontSizeBody}"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="{DynamicResource TextDockRelativeToADisplayWorkingAreaThePrimaryDisplayIsUsedIfTheSelectedDisplayIsUnavailable}"
                            TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DisplayOption">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid
                            ColumnDefinitions="*,120"
                            ColumnSpacing="10"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextBodyBrush}"
                                Text="{DynamicResource TextDockEdge}" />
                            <ComboBox
                                Grid.Column="1"
                                ItemsSource="{Binding DockEdges}"
                                SelectedItem="{Binding DockEdge}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource LocalizedEnumConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextBodyBrush}"
                                Text="{DynamicResource TextVerticalPosition}" />
                            <NumericUpDown
                                Grid.Row="1"
                                Grid.Column="1"
                                FormatString="0%"
                                Increment="5"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding VerticalPositionPercent}" />
                        </Grid>
                        <CheckBox Content="{DynamicResource TextReserveTheDockedAreaOnWindows}" IsChecked="{Binding ReserveScreenSpace}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{DynamicResource TextAlertThresholds}" />
                        <Grid
                            ColumnDefinitions="*,100"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                            RowSpacing="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextBodyBrush}"
                                Text="{DynamicResource TextCPU}" />
                            <NumericUpDown
                                Grid.Column="1"
                                FormatString="0%"
                                Maximum="100"
                                Minimum="1"
                                Value="{Binding CpuAlertThreshold}" />
                            <TextBlock
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextBodyBrush}"
                                Text="{DynamicResource TextMemory}" />
                            <NumericUpDown
                                Grid.Row="1"
                                Grid.Column="1"
                                FormatString="0%"
                                Maximum="100"
                                Minimum="1"
                                Value="{Binding MemoryAlertThreshold}" />
                            <TextBlock
                                Grid.Row="2"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextBodyBrush}"
                                Text="{DynamicResource TextStorage}" />
                            <NumericUpDown
                                Grid.Row="2"
                                Grid.Column="1"
                                FormatString="0%"
                                Maximum="100"
                                Minimum="1"
                                Value="{Binding StorageAlertThreshold}" />
                            <TextBlock
                                Grid.Row="3"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextBodyBrush}"
                                Text="{DynamicResource TextNetwork}" />
                            <NumericUpDown
                                Grid.Row="3"
                                Grid.Column="1"
                                FormatString="0%"
                                Maximum="100"
                                Minimum="1"
                                Value="{Binding NetworkAlertThreshold}" />
                            <TextBlock
                                Grid.Row="4"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextBodyBrush}"
                                Text="{DynamicResource TextGPU}" />
                            <NumericUpDown
                                Grid.Row="4"
                                Grid.Column="1"
                                FormatString="0%"
                                Maximum="100"
                                Minimum="1"
                                Value="{Binding GpuAlertThreshold}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{DynamicResource TextPrimaryGPU}" />
                        <TextBlock
                            FontSize="{DynamicResource FontSizeBody}"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="{DynamicResource TextSelectTheDeviceRepresentedByTheGPUSummaryCard}"
                            TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding GpuDevices}" SelectedItem="{Binding SelectedGpu}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GpuDeviceOption">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{DynamicResource TextHardwareSensors}" />
                        <TextBlock
                            FontSize="{DynamicResource FontSizeBody}"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="{DynamicResource TextChooseRenamePinAndOrderTheReadingsShownInTheSidebar}"
                            TextWrapping="Wrap" />
                        <TextBox PlaceholderText="{DynamicResource TextSearchSensors}" Text="{Binding SensorSearchText}" />
                        <ItemsControl ItemsSource="{Binding Sensors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SensorOptionViewModel">
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="10"
                                        Background="{DynamicResource BackgroundInputBrush}"
                                        BorderBrush="{DynamicResource BorderCardBrush}"
                                        BorderThickness="{DynamicResource ThicknessBorder}"
                                        CornerRadius="{DynamicResource RadiusMedium}"
                                        IsVisible="{Binding IsMatch}">
                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="8"
                                            RowDefinitions="Auto,Auto,Auto"
                                            RowSpacing="7">
                                            <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsVisible}" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock
                                                    FontSize="{DynamicResource FontSizeDescription}"
                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                    Text="{Binding Sensor}" />
                                                <TextBlock
                                                    FontSize="{DynamicResource FontSizeCaption}"
                                                    Foreground="{DynamicResource TextDimBrush}"
                                                    Text="{Binding Device}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="4">
                                                <Button
                                                    Padding="7,3"
                                                    Command="{Binding MoveUpCommand}"
                                                    Content="↑" />
                                                <Button
                                                    Padding="7,3"
                                                    Command="{Binding MoveDownCommand}"
                                                    Content="↓" />
                                            </StackPanel>
                                            <TextBox
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                PlaceholderText="{DynamicResource TextCustomDisplayName}"
                                                Text="{Binding CustomName}" />
                                            <CheckBox
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Content="{DynamicResource TextPinToTop}"
                                                IsChecked="{Binding IsPinned}" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource FontSizeCaption}"
                                                Foreground="{DynamicResource TextDimBrush}"
                                                Text="{Binding Availability}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="{DynamicResource TextExternalJSONMetrics}" />
                                <TextBlock
                                    FontSize="{DynamicResource FontSizeBody}"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{DynamicResource TextReadNumericValuesFromLocalFilesOrExplicitHTTPEndpoints}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Command="{Binding AddExternalMetricCommand}"
                                Content="{DynamicResource TextAddSource}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ExternalMetrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExternalMetricOptionViewModel">
                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="12"
                                        Background="{DynamicResource BackgroundInputBrush}"
                                        BorderBrush="{DynamicResource BorderCardBrush}"
                                        BorderThickness="{DynamicResource ThicknessBorder}"
                                        CornerRadius="{DynamicResource RadiusMedium}">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <TextBox PlaceholderText="{DynamicResource TextCardTitle}" Text="{Binding Title}" />
                                                <CheckBox
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Content="{DynamicResource TextEnabled}"
                                                    IsChecked="{Binding IsEnabled}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Command="{Binding RemoveCommand}"
                                                    Content="{DynamicResource TextRemove}" />
                                            </Grid>
                                            <ComboBox ItemsSource="{Binding SourceKinds}" SelectedItem="{Binding SourceKind}" />
                                            <TextBox PlaceholderText="{DynamicResource TextFilePathOrHttpsEndpoint}" Text="{Binding Source}" />
                                            <Grid ColumnDefinitions="*,100" ColumnSpacing="8">
                                                <TextBox PlaceholderText="{DynamicResource TextJSONPathForExampleRouterDownload}" Text="{Binding JsonPath}" />
                                                <TextBox
                                                    Grid.Column="1"
                                                    PlaceholderText="{DynamicResource TextUnit}"
                                                    Text="{Binding Unit}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                                <NumericUpDown FormatString="0.##" Value="{Binding Minimum}" />
                                                <NumericUpDown
                                                    Grid.Column="1"
                                                    FormatString="0.##"
                                                    Value="{Binding Maximum}" />
                                                <NumericUpDown
                                                    Grid.Column="2"
                                                    FormatString="0 sec"
                                                    Maximum="3600"
                                                    Minimum="5"
                                                    Value="{Binding RefreshIntervalSeconds}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Button Command="{Binding TestCommand}" Content="{DynamicResource TextTestSource}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="{DynamicResource FontSizeCaption}"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    Text="{Binding PreviewStatus}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <CheckBox Content="{DynamicResource TextKeepTheSidebarAboveOtherWindows}" IsChecked="{Binding AlwaysOnTop}" />
                        <CheckBox
                            Content="{DynamicResource TextLetPointerInputPassThroughTheSidebar}"
                            IsChecked="{Binding ClickThrough}"
                            IsEnabled="{Binding IsClickThroughSupported}"
                            ToolTip.Tip="{DynamicResource TextWindowsOnlyUseTheTrayMenuOrAGlobalShortcutToOpenSettingsAgain}" />
                        <CheckBox Content="{DynamicResource TextLaunchAtLogin}" IsChecked="{Binding LaunchAtLogin}" />
                        <CheckBox Content="{DynamicResource TextStartMinimized}" IsChecked="{Binding StartMinimized}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="28,14"
            Background="{DynamicResource BackgroundPanelBrush}"
            BorderBrush="{DynamicResource BorderChromeBrush}"
            BorderThickness="{DynamicResource ThicknessChromeTop}">
            <Grid
                MaxWidth="920"
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="10">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextDangerBrush}"
                    IsVisible="{Binding !!ThemePreviewError}"
                    Text="{Binding ThemePreviewError}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding ThemePreviewError}" />
                <Button
                    Grid.Column="1"
                    Command="{Binding CancelCommand}"
                    Content="{DynamicResource TextCancel}" />
                <Button
                    Grid.Column="2"
                    Classes="primary"
                    Command="{Binding SaveCommand}"
                    Content="{DynamicResource TextSaveChanges}" />
            </Grid>
        </Border>
    </Grid>
</Window>
