<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SidebarDiagnostics.App.ViewModels"
        x:Class="SidebarDiagnostics.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Sidebar Diagnostics Settings"
        Width="440"
        Height="780"
        MinWidth="400"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F17">
    <ScrollViewer>
        <StackPanel Margin="28" Spacing="22">
            <StackPanel Spacing="4">
                <TextBlock Text="SETTINGS" FontSize="11" FontWeight="SemiBold" Foreground="#7DD3FC" LetterSpacing="1.8" />
                <TextBlock Text="Monitoring preferences" FontSize="24" FontWeight="SemiBold" Foreground="#F8FAFC" />
                <TextBlock Text="Changes apply immediately and persist across sessions." FontSize="12" Foreground="#94A3B8" />
            </StackPanel>

            <Border Padding="18" CornerRadius="14" Background="#111827" BorderBrush="#1F2937" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Global shortcuts" FontWeight="SemiBold" Foreground="#E2E8F0" />
                    <TextBlock Text="Use modifiers plus a letter, number, or function key. Clear a field to disable it." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <TextBlock Text="Show and focus" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding ShowShortcut}" />
                        <TextBlock Grid.Row="1" Text="Hide" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HideShortcut}" />
                        <TextBlock Grid.Row="2" Text="Toggle" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ToggleShortcut}" />
                    </Grid>
                    <TextBlock Text="{Binding ShortcutStatus}" FontSize="11" Foreground="#7DD3FC" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="14" Background="#111827" BorderBrush="#1F2937" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Refresh interval" FontWeight="SemiBold" Foreground="#E2E8F0" />
                    <NumericUpDown Value="{Binding RefreshIntervalMilliseconds}" Minimum="250" Maximum="10000" Increment="250" FormatString="0 ms" />
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="14" Background="#111827" BorderBrush="#1F2937" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance" FontWeight="SemiBold" Foreground="#E2E8F0" />
                    <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <TextBlock Text="Sidebar width" VerticalAlignment="Center" Foreground="#CBD5E1" />
                        <NumericUpDown Grid.Column="1" Value="{Binding SidebarWidth}" Minimum="320" Maximum="640" Increment="10" FormatString="0 px" />
                        <TextBlock Grid.Row="1" Text="Opacity" VerticalAlignment="Center" Foreground="#CBD5E1" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding BackgroundOpacity}" Minimum="0.35" Maximum="1" Increment="0.05" FormatString="0%" />
                    </Grid>
                    <CheckBox Content="Show machine name" IsChecked="{Binding ShowMachineName}" />
                    <CheckBox Content="Show clock and date" IsChecked="{Binding ShowClock}" />
                    <CheckBox Content="Use 24-hour clock" IsChecked="{Binding Use24HourClock}" />
                    <CheckBox Content="Show temperatures in Fahrenheit" IsChecked="{Binding UseFahrenheit}" />
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="14" Background="#111827" BorderBrush="#1F2937" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Display placement" FontWeight="SemiBold" Foreground="#E2E8F0" />
                    <TextBlock Text="Dock relative to a display working area. The primary display is used if the selected display is unavailable."
                               FontSize="11"
                               Foreground="#94A3B8"
                               TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DisplayOption">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <TextBlock Text="Dock edge" VerticalAlignment="Center" Foreground="#CBD5E1" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding DockEdges}" SelectedItem="{Binding DockEdge}" />
                        <TextBlock Grid.Row="1" Text="Vertical position" VerticalAlignment="Center" Foreground="#CBD5E1" />
                        <NumericUpDown Grid.Row="1"
                                       Grid.Column="1"
                                       Value="{Binding VerticalPositionPercent}"
                                       Minimum="0"
                                       Maximum="100"
                                       Increment="5"
                                       FormatString="0%" />
                    </Grid>
                    <CheckBox Content="Reserve the docked area on Windows"
                              IsChecked="{Binding ReserveScreenSpace}" />
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="14" Background="#111827" BorderBrush="#1F2937" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="Alert thresholds" FontWeight="SemiBold" Foreground="#E2E8F0" />
                    <Grid ColumnDefinitions="*,100" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                        <TextBlock Text="CPU" VerticalAlignment="Center" Foreground="#CBD5E1" />
                        <NumericUpDown Grid.Column="1" Value="{Binding CpuAlertThreshold}" Minimum="1" Maximum="100" FormatString="0%" />
                        <TextBlock Grid.Row="1" Text="Memory" VerticalAlignment="Center" Foreground="#CBD5E1" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MemoryAlertThreshold}" Minimum="1" Maximum="100" FormatString="0%" />
                        <TextBlock Grid.Row="2" Text="Storage" VerticalAlignment="Center" Foreground="#CBD5E1" />
                        <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding StorageAlertThreshold}" Minimum="1" Maximum="100" FormatString="0%" />
                        <TextBlock Grid.Row="3" Text="Network" VerticalAlignment="Center" Foreground="#CBD5E1" />
                        <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding NetworkAlertThreshold}" Minimum="1" Maximum="100" FormatString="0%" />
                        <TextBlock Grid.Row="4" Text="GPU" VerticalAlignment="Center" Foreground="#CBD5E1" />
                        <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding GpuAlertThreshold}" Minimum="1" Maximum="100" FormatString="0%" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="14" Background="#111827" BorderBrush="#1F2937" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Primary GPU" FontWeight="SemiBold" Foreground="#E2E8F0" />
                    <TextBlock Text="Select the device represented by the GPU summary card."
                               FontSize="11"
                               Foreground="#94A3B8"
                               TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding GpuDevices}"
                              SelectedItem="{Binding SelectedGpu}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GpuDeviceOption">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="14" Background="#111827" BorderBrush="#1F2937" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Hardware sensors" FontWeight="SemiBold" Foreground="#E2E8F0" />
                    <TextBlock Text="Choose, rename, pin, and order the readings shown in the sidebar."
                               FontSize="11"
                               Foreground="#94A3B8"
                               TextWrapping="Wrap" />
                    <TextBox Text="{Binding SensorSearchText}" PlaceholderText="Search sensors" />
                    <ItemsControl ItemsSource="{Binding Sensors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SensorOptionViewModel">
                                <Border IsVisible="{Binding IsMatch}"
                                        Margin="0,0,0,8"
                                        Padding="10"
                                        CornerRadius="10"
                                        Background="#0B1220"
                                        BorderBrush="#1F2937"
                                        BorderThickness="1">
                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="7">
                                        <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{Binding Sensor}" FontSize="12" Foreground="#E2E8F0" />
                                            <TextBlock Text="{Binding Device}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                            <Button Content="↑" Command="{Binding MoveUpCommand}" Padding="7,3" />
                                            <Button Content="↓" Command="{Binding MoveDownCommand}" Padding="7,3" />
                                        </StackPanel>
                                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                 Text="{Binding CustomName}"
                                                 PlaceholderText="Custom display name" />
                                        <CheckBox Grid.Row="2" Grid.Column="1" Content="Pin to top" IsChecked="{Binding IsPinned}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2"
                                                   Text="{Binding Availability}"
                                                   FontSize="10"
                                                   Foreground="#64748B"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="14" Background="#111827" BorderBrush="#1F2937" BorderThickness="1">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="External JSON metrics" FontWeight="SemiBold" Foreground="#E2E8F0" />
                            <TextBlock Text="Read numeric values from local files or explicit HTTP endpoints."
                                       FontSize="11"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Add source" Command="{Binding AddExternalMetricCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ExternalMetrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExternalMetricOptionViewModel">
                                <Border Margin="0,0,0,10" Padding="12" CornerRadius="10" Background="#0B1220" BorderBrush="#1F2937" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <TextBox Text="{Binding Title}" PlaceholderText="Card title" />
                                            <CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveCommand}" />
                                        </Grid>
                                        <ComboBox ItemsSource="{Binding SourceKinds}" SelectedItem="{Binding SourceKind}" />
                                        <TextBox Text="{Binding Source}" PlaceholderText="File path or https:// endpoint" />
                                        <Grid ColumnDefinitions="*,100" ColumnSpacing="8">
                                            <TextBox Text="{Binding JsonPath}" PlaceholderText="JSON path, for example router.download" />
                                            <TextBox Grid.Column="1" Text="{Binding Unit}" PlaceholderText="Unit" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                            <NumericUpDown Value="{Binding Minimum}" FormatString="0.##" />
                                            <NumericUpDown Grid.Column="1" Value="{Binding Maximum}" FormatString="0.##" />
                                            <NumericUpDown Grid.Column="2"
                                                           Value="{Binding RefreshIntervalSeconds}"
                                                           Minimum="5"
                                                           Maximum="3600"
                                                           FormatString="0 sec" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Button Content="Test source" Command="{Binding TestCommand}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PreviewStatus}"
                                                       FontSize="10"
                                                       Foreground="#94A3B8"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="14" Background="#111827" BorderBrush="#1F2937" BorderThickness="1">
                <StackPanel Spacing="12">
                    <CheckBox Content="Keep the sidebar above other windows" IsChecked="{Binding AlwaysOnTop}" />
                    <CheckBox Content="Launch at login" IsChecked="{Binding LaunchAtLogin}" />
                    <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Content="Save changes" Command="{Binding SaveCommand}" Classes="accent" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
