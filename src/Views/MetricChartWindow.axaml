<Window
    x:Class="SidebarDiagnostics.App.Views.MetricChartWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SidebarDiagnostics.App.Controls"
    Title="Live metric"
    Width="720"
    Height="460"
    MinWidth="520"
    MinHeight="340"
    Background="{DynamicResource BackgroundWindowBrush}"
    ExtendClientAreaToDecorationsHint="True"
    WindowDecorations="BorderOnly"
    WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,Auto,*">
        <Border
            MinHeight="56"
            BorderBrush="{DynamicResource BorderChromeBrush}"
            BorderThickness="{DynamicResource ThicknessChromeBottom}">
            <Grid
                Margin="16,0,12,0"
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="8">
                <Border
                    x:Name="DragRegion"
                    Grid.Column="0"
                    Background="{DynamicResource TransparentBrush}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <Border
                            Width="30"
                            Height="30"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BackgroundAccentSubtleBrush}"
                            CornerRadius="{DynamicResource RadiusSmall}">
                            <Path
                                Width="16"
                                Height="14"
                                Data="M 1,12 L 5,7 L 8,9 L 14,2"
                                Stretch="Fill"
                                Stroke="{DynamicResource TextAccentBrush}"
                                StrokeThickness="1.7" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="1">
                            <TextBlock
                                x:Name="TitleText"
                                FontSize="{DynamicResource FontSizeSubheading}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock
                                x:Name="SubtitleText"
                                MaxWidth="480"
                                FontSize="{DynamicResource FontSizeCaption}"
                                Foreground="{DynamicResource TextSubtleBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Button
                    x:Name="PinButton"
                    Grid.Column="1"
                    Classes="chrome"
                    Click="TogglePin"
                    ToolTip.Tip="Keep on top">
                    <Path
                        Width="15"
                        Height="17"
                        Classes="chrome-icon"
                        Data="M 4,1 L 12,1 L 10,5 L 10,9 L 13,12 L 3,12 L 6,9 L 6,5 Z M 8,12 L 8,17"
                        Stretch="Fill"
                        StrokeLineCap="Round"
                        StrokeThickness="1.4" />
                </Button>
                <Button
                    Grid.Column="2"
                    Classes="chrome close"
                    Click="CloseWindow"
                    ToolTip.Tip="Close chart">
                    <Path
                        Width="13"
                        Height="13"
                        Classes="chrome-icon"
                        Data="M 1,1 L 12,12 M 12,1 L 1,12"
                        Stretch="Fill"
                        StrokeLineCap="Round"
                        StrokeThickness="1.6" />
                </Button>
            </Grid>
        </Border>
        <Grid
            Grid.Row="1"
            Margin="20,17,20,14"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="20">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <TextBlock
                    x:Name="CurrentValueText"
                    FontSize="{DynamicResource FontSizeDisplay}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
                <Border
                    Height="24"
                    Padding="8,0"
                    Background="{DynamicResource BackgroundSuccessBrush}"
                    CornerRadius="{DynamicResource RadiusSmall}">
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                        <Ellipse
                            Width="6"
                            Height="6"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource AccentSuccessBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSizeMicro}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextSuccessBrush}"
                            LetterSpacing="1.2"
                            LineHeight="11"
                            Text="LIVE" />
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="9">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeBody}"
                    Foreground="{DynamicResource TextSubtleBrush}"
                    Text="TIME RANGE" />
                <ComboBox
                    x:Name="DurationSelector"
                    Width="126"
                    SelectionChanged="ChangeDuration" />
            </StackPanel>
        </Grid>
        <Border
            Grid.Row="2"
            Margin="20,0,20,20"
            Background="{DynamicResource BackgroundPanelBrush}"
            BorderBrush="{DynamicResource BackgroundControlHoverBrush}"
            BorderThickness="{DynamicResource ThicknessBorder}"
            CornerRadius="{DynamicResource RadiusPanel}">
            <controls:MetricChart x:Name="Chart" Margin="10" />
        </Border>
    </Grid>
</Window>
