<Window
    x:Class="SidebarDiagnostics.App.Views.MetricChartWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SidebarDiagnostics.App.Controls"
    Title="Live metric"
    Width="640"
    Height="400"
    MinWidth="420"
    MinHeight="280"
    Background="#0B0F17"
    WindowStartupLocation="CenterScreen"
    WindowDecorations="None">
    <Grid RowDefinitions="Auto,Auto,*">
        <Border Padding="18,14" BorderBrush="#1B2535" BorderThickness="0,0,0,1" PointerPressed="BeginWindowDrag">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" />
                    <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Width="36" Height="36" Padding="0" Click="TogglePin" ToolTip.Tip="Keep on top">
                    <TextBlock x:Name="PinText" Text="◇" FontSize="18" />
                </Button>
                <Button Grid.Column="2" Width="36" Height="36" Padding="0" Click="CloseWindow" ToolTip.Tip="Close">
                    <TextBlock Text="×" FontSize="20" />
                </Button>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="18,14,18,10" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel>
                <TextBlock x:Name="CurrentValueText" FontSize="28" FontWeight="SemiBold" Foreground="#F8FAFC" />
                <TextBlock Text="LIVE" FontSize="10" FontWeight="SemiBold" Foreground="#34D399" LetterSpacing="1.4" />
            </StackPanel>
            <ComboBox x:Name="DurationSelector" Grid.Column="1" Width="116" VerticalAlignment="Center" SelectionChanged="ChangeDuration" />
        </Grid>
        <Border Grid.Row="2" Margin="18,0,18,18" Padding="12" Background="#101722" CornerRadius="14">
            <controls:MetricChart x:Name="Chart" />
        </Border>
    </Grid>
</Window>
