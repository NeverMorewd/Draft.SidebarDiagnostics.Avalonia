<Window
    x:Class="SidebarDiagnostics.App.Views.AboutWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SidebarDiagnostics.App.Models"
    Title="{DynamicResource TextAboutSidebarDiagnostics}"
    Width="540"
    Height="570"
    x:DataType="models:AboutInfo"
    Background="{DynamicResource BackgroundWindowBrush}"
    CanResize="False"
    ExtendClientAreaToDecorationsHint="True"
    ShowInTaskbar="False"
    WindowDecorations="BorderOnly"
    WindowStartupLocation="CenterScreen">
    <Grid
        Margin="28"
        RowDefinitions="Auto,Auto,Auto,*,Auto"
        RowSpacing="18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Border
                Width="48"
                Height="48"
                Background="{DynamicResource BackgroundAccentSubtleBrush}"
                CornerRadius="{DynamicResource RadiusCard}">
                <Path
                    Width="24"
                    Height="21"
                    Data="M 1,18 L 7,11 L 12,14 L 22,3"
                    Stretch="Fill"
                    Stroke="{DynamicResource TextAccentBrush}"
                    StrokeThickness="2" />
            </Border>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    FontSize="{DynamicResource FontSizeTitle}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="{DynamicResource TextSidebarDiagnostics}" />
                <TextBlock
                    FontSize="{DynamicResource FontSizeBody}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextAccentBrush}"
                    LetterSpacing="1.2"
                    Text="{DynamicResource TextCROSSPLATFORMSYSTEMMONITOR}" />
            </StackPanel>
        </Grid>

        <TextBlock
            Grid.Row="1"
            FontSize="{DynamicResource FontSizeDescription}"
            Foreground="{DynamicResource TextMutedBrush}"
            Text="{DynamicResource TextAModernAvaloniaPortOfSidebarDiagnosticsForWindowsMacOSAndLinux}"
            TextWrapping="Wrap" />

        <Border
            Grid.Row="2"
            Padding="16"
            Background="{DynamicResource BackgroundCardBrush}"
            BorderBrush="{DynamicResource BorderPanelBrush}"
            BorderThickness="{DynamicResource ThicknessBorder}"
            CornerRadius="{DynamicResource RadiusCard}">
            <Grid
                ColumnDefinitions="140,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                RowSpacing="10">
                <TextBlock Foreground="{DynamicResource TextSubtleBrush}" Text="{DynamicResource TextApplicationVersion}" />
                <TextBlock
                    Grid.Column="1"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding ApplicationVersion}" />
                <TextBlock
                    Grid.Row="1"
                    Foreground="{DynamicResource TextSubtleBrush}"
                    Text="{DynamicResource TextAvalonia}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding AvaloniaVersion}" />
                <TextBlock
                    Grid.Row="2"
                    Foreground="{DynamicResource TextSubtleBrush}"
                    Text="{DynamicResource TextNETRuntime}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding DotNetVersion}" />
                <TextBlock
                    Grid.Row="3"
                    Foreground="{DynamicResource TextSubtleBrush}"
                    Text="{DynamicResource TextAuthor}" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding Author}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="4"
                    Foreground="{DynamicResource TextSubtleBrush}"
                    Text="{DynamicResource TextLicense}" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding License}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Spacing="10">
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{DynamicResource TextOpenSource}" />
            <TextBlock
                Foreground="{DynamicResource TextMutedBrush}"
                Text="{DynamicResource TextSourceCodeReleasesAndProjectDocumentationAreAvailableOnGitHub}"
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Left"
                Click="OpenRepository"
                Content="{DynamicResource TextOpenRepository}" />
            <TextBlock
                Margin="0,6,0,0"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{DynamicResource TextNeedHelpOrFoundAProblem}" />
            <TextBlock
                Foreground="{DynamicResource TextMutedBrush}"
                Text="{DynamicResource TextPleaseReportBugsAndFeatureRequestsThroughGitHubIssues}"
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Left"
                Click="OpenIssues"
                Content="{DynamicResource TextReportAnIssue}" />
        </StackPanel>

        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Center"
            Spacing="8">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="{DynamicResource FontSizeCaption}"
                Foreground="{DynamicResource TextDimBrush}"
                Text="{Binding LicenseNotice}" />
            <Button
                MinWidth="88"
                HorizontalAlignment="Center"
                Click="CloseWindow"
                Content="{DynamicResource TextClose}" />
        </StackPanel>
    </Grid>
</Window>
